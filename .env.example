# Optional browser configuration. Leave both blank for the fictional demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set to google after enabling Google in the connected Supabase project.
FINANCE_AUTH_MODE=
# Public Google OAuth web client ID. Keep the client secret in Supabase.
GOOGLE_CLIENT_ID=
# Server only. Never use a NEXT_PUBLIC_ prefix for AI credentials.
GEMINI_API_KEY=
# Optional server-only key from a separately provisioned project with available quota.
# Keys in the same Google Cloud project share quota; another key there will not help.
GEMINI_FALLBACK_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional model with independent available quota; blank keeps the primary model.
GEMINI_FALLBACK_MODEL=
